{
  "tasks": [
    {
      "label": "codegen: Format C++",
      "command": "${workspaceFolder}/codegen/scripts/run_clang_format.sh -m -f",
    },
    {
      "label": "codegen: Format Python",
      "command": "${workspaceFolder}/codegen/scripts/run_python_check.sh -m -f",
    },
    {
      "label": "codegen: Build",
      "command": "bash bin/build &&\nenv -u PYTHONPATH bash -lc 'source \"${workspaceFolder}/codegen/build/codegen_pythonpath.sh\" &&\nprintf \"PYTHONPATH=%s\\n\" \"$PYTHONPATH\"' >| \"${workspaceFolder}/.vscode/.env\"\n",
      "group": {
        "kind": "build",
        "isDefault": true,
      },
      "options": {
        "cwd": "${workspaceFolder}/codegen",
      },
    },
    {
      "label": "fx2onnx: Format",
      "command": "${workspaceFolder}/fx2onnx/scripts/run-pysen-format.sh",
    },
    {
      "label": "pfvm: Format",
      "command": "source .pfvm_venv/bin/activate &&\nbash scripts/run-pysen-format.sh\n",
      "options": {
        "cwd": "${workspaceFolder}/pfvm",
      },
    },
    {
      "label": "echofile",
      "command": "echo ${file}",
    },
    {
      "label": "nandemo-share",
      "command": "src=${file};\ndst=${src//\\/mnt\\/pvc-home/\\/mnt\\/chip-pvc\\/tmp};\nmkdir -p $(dirname $dst) &&\ncp $src $dst &&\necho https://chip-nandemo-share.pfn.yh1-01.ingress.pfcomputing.com/file$dst\n",
    },
    {
      "label": "Get pod name",
      "command": "kubectl get pods -o wide",
    },
    {
      "label": "Convert YAML/JSON",
      "command": "python3 \"${HOME}/.dotfiles/scripts/convert_yaml_json.py\" ${file}",
    },
    {
      "label": "Secretary",
      "command": "claude -p '/secretary'",
    },
  ],
  "type": "shell",
  "group": "none",
  "presentation": {
    "clear": true,
    "echo": false,
    "reveal": "always",
    "showReuseMessage": true,
  },
  "problemMatcher": "$gcc",
  "version": "2.0.0",
}
